DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_fx_trader?schema=public"
YFINANCE_SERVICE_URL="http://localhost:8765"

# OANDA demo trading (npm run demo:donchian) — practice environment only.
# This repo does not load .env into process.env automatically; export these
# in your shell (fish: `set -gx OANDA_API_TOKEN ...`) or via `node --env-file`.
OANDA_API_TOKEN=""
OANDA_ACCOUNT_ID=""
# Optional override; defaults to the practice host. Anything not containing
# "fxpractice" is rejected by OandaClient's constructor.
OANDA_API_URL="https://api-fxpractice.oanda.com"
# Slack incoming webhook for the demo trading log (entries/exits/divergence).
# Leave unset to disable notifications entirely.
SLACK_WEBHOOK_URL=""
